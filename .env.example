# Copy to .env for local use (the app reads it automatically). Never commit real values.
SECRET_KEY=change-me-long-random-string
DATABASE_URL=sqlite:///./kirana.db
# Demo mode enables the fixed login code below. Fake data only. Turn OFF for anything real.
DEMO_MODE=1
DEMO_OTP=123456
# Set to 1 when served over HTTPS (production) so the session cookie is HTTPS-only.
COOKIE_SECURE=0
# Optional: enables the LLM tiebreaker in AI capture. Leave empty to run rules-only.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
